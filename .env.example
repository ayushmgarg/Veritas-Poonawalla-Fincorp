# ─── Supabase ────────────────────────────────────────────────────────────────
# supabase.com → project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key   # server-only, never expose

# ─── LLM Providers ───────────────────────────────────────────────────────────
# Groq — PRIMARY (free, no credit card) — console.groq.com → API Keys
GROQ_API_KEY=gsk_your_key_here

# Gemini — FALLBACK on Groq rate-limit (free) — aistudio.google.com/apikey
GEMINI_API_KEY=AIza_your_key_here

# ─── Twilio WhatsApp ─────────────────────────────────────────────────────────
# twilio.com → Console → Account Info
# WhatsApp sandbox: twilio.com/console/sms/whatsapp/sandbox
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886      # sandbox number (or your approved sender)
TWILIO_ADMIN_WHATSAPP=whatsapp:+91XXXXXXXXXX    # your number — receives metrics report on each approval

# ─── DigiLocker Sandbox (optional) ───────────────────────────────────────────
# partners.digitallocker.gov.in — register as "Requester" entity (2-3 day approval)
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=http://localhost:3000/api/verify/digilocker/callback

# ─── Setu Account Aggregator Sandbox (optional) ──────────────────────────────
# bridge.setu.co → AA → Sandbox (instant signup)
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_AA_BASE_URL=https://fiu-sandbox.setu.co

# ─── App ─────────────────────────────────────────────────────────────────────
# Must be your actual domain in production (used for internal API calls on accept)
NEXT_PUBLIC_APP_URL=http://localhost:3000
