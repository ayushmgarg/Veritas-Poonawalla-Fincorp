# Supabase — supabase.com → project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Groq — PRIMARY LLM (free, instant) — console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Gemini — FALLBACK LLM (free, instant) — aistudio.google.com/apikey
GEMINI_API_KEY=AIza_your_key_here

# DigiLocker Sandbox — partners.digitallocker.gov.in (2-3 day approval)
# Register as "Requester" entity type
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=http://localhost:3000/api/verify/digilocker/callback

# Setu Account Aggregator Sandbox — bridge.setu.co (instant)
# Sign up → AA → Sandbox credentials
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_AA_BASE_URL=https://fiu-sandbox.setu.co

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
